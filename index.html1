<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#080b16">
<title>NEXUS GAMING</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;800&family=Poppins:wght@400;500;600;700&display=swap');

:root{
  --bg:#080b16;--panel:#111728;--panel2:#171e32;--cyan:#00e5ff;
  --purple:#a855f7;--pink:#ff4fa3;--green:#38e58c;--yellow:#ffd166;
  --text:#f6f8ff;--muted:#98a3bc;--line:#29334d;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:radial-gradient(circle at 80% -10%,#1b2850 0,#080b16 34%);color:var(--text);font-family:Poppins,Arial,sans-serif;min-height:100vh;padding-bottom:92px}
button,input,select{font:inherit}
button{cursor:pointer}
.app{max-width:1200px;margin:auto;padding:0 18px}
.topbar{display:flex;align-items:center;justify-content:space-between;padding:17px 0;position:sticky;top:0;background:#080b16eF;backdrop-filter:blur(16px);z-index:30;border-bottom:1px solid #ffffff0c}
.logo{font:800 21px Orbitron,sans-serif;letter-spacing:1px}.logo b{color:var(--cyan)}
.top-actions{display:flex;gap:9px;align-items:center}
.icon-btn{width:40px;height:40px;border-radius:12px;border:1px solid var(--line);background:var(--panel);color:white}
.avatar{width:42px;height:42px;border-radius:13px;background:linear-gradient(135deg,var(--purple),var(--cyan));display:grid;place-items:center;font-size:20px}
h1,h2,h3{font-family:Orbitron,sans-serif}
.page{display:none;animation:fade .25s ease}.page.active{display:block}
.eyebrow{font-size:11px;color:var(--cyan);letter-spacing:2px;font-weight:700}
.welcome{padding:28px 0 18px}.welcome h1{font-size:clamp(26px,5vw,40px);margin:8px 0}.welcome p,.sub{color:var(--muted);font-size:13px}
.hero{position:relative;min-height:330px;border-radius:24px;overflow:hidden;padding:30px;display:flex;align-items:end;
background:linear-gradient(90deg,#080b16 0%,#080b16dc 40%,#080b1640),linear-gradient(0deg,#080b16bb,transparent),
url('https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=1600&q=85') center/cover;
border:1px solid #ffffff12;box-shadow:0 20px 60px #0007}
.hero-content{max-width:610px}.pill{display:inline-block;background:#00e5ff18;border:1px solid #00e5ff55;color:var(--cyan);border-radius:30px;padding:6px 11px;font-size:10px;font-weight:700;letter-spacing:1px}
.hero h2{font-size:clamp(27px,5vw,45px);line-height:1.12;margin:13px 0}.hero h2 span{color:var(--cyan)}.hero p{font-size:13px;color:#c5ccdc;line-height:1.7;margin-bottom:18px}
.actions{display:flex;gap:9px;flex-wrap:wrap}
.primary{background:var(--cyan);color:#061018;border:0;border-radius:11px;padding:12px 18px;font-weight:700;box-shadow:0 0 25px #00e5ff25}
.secondary{background:#ffffff12;color:white;border:1px solid #ffffff22;border-radius:11px;padding:11px 16px;font-weight:600}
.quick-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:18px 0}
.stat{background:linear-gradient(145deg,var(--panel),#0e1424);border:1px solid var(--line);border-radius:15px;padding:15px}
.stat strong{display:block;font:700 20px Orbitron;color:var(--cyan)}.stat span{font-size:11px;color:var(--muted)}
.section-head{display:flex;align-items:center;justify-content:space-between;margin:30px 0 15px}.section-head h2{font-size:18px}
.text-btn{border:0;background:none;color:var(--cyan);font-size:12px;font-weight:600}
.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px}
.card{background:var(--panel);border:1px solid var(--line);border-radius:16px;overflow:hidden;transition:.25s;box-shadow:0 10px 30px #0002}
.card:hover{transform:translateY(-5px);border-color:#00e5ff88;box-shadow:0 15px 35px #00e5ff12}
.cover{height:160px;position:relative;background:#151c2f}.cover img{width:100%;height:100%;object-fit:cover}
.cover:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,#080b16aa,transparent 55%)}
.genre,.year{position:absolute;z-index:2;background:#080b16d9;border:1px solid #ffffff16;border-radius:7px;padding:5px 8px;font-size:9px;color:var(--cyan)}
.genre{left:9px;top:9px}.year{right:9px;top:9px;color:#dce3f4}
.heart{position:absolute;z-index:3;right:9px;bottom:9px;border:0;border-radius:50%;width:32px;height:32px;background:#080b16dc;color:#fff;font-size:18px}.heart.on{color:var(--pink)}
.card-body{padding:13px}.card h3{font:700 14px Poppins,sans-serif;margin-bottom:5px}
.card p{font-size:10px;line-height:1.55;color:var(--muted);min-height:32px}
.meta{display:flex;gap:7px;flex-wrap:wrap;margin-top:9px}.tag{font-size:9px;color:#cdd5e8;background:#ffffff08;border:1px solid #ffffff10;padding:4px 7px;border-radius:6px}
.card-foot{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--line);padding-top:10px;margin-top:10px}
.rating{font-size:11px;color:var(--yellow)}.details{background:none;border:0;color:var(--cyan);font-size:10px;font-weight:700}
.search-row{display:flex;gap:10px;margin:18px 0 10px}.search{flex:1;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:13px 15px;color:white;outline:none}.search:focus{border-color:var(--cyan)}
.sort{background:var(--panel);border:1px solid var(--line);border-radius:12px;color:white;padding:0 11px}
.filters{display:flex;gap:8px;overflow-x:auto;padding:2px 0 14px}.filter{white-space:nowrap;border:1px solid var(--line);background:var(--panel);color:#c8d0e2;border-radius:30px;padding:8px 14px;font-size:11px}.filter.active{background:var(--cyan);color:#071018;border-color:var(--cyan);font-weight:700}
.empty{display:none;grid-column:1/-1;text-align:center;padding:40px;color:var(--muted);font-size:13px}
.info-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:20px 0}.info-box{padding:17px;border-radius:15px;background:var(--panel);border:1px solid var(--line)}.info-box b{display:block;color:var(--cyan);font-size:13px;margin-bottom:5px}.info-box span{font-size:11px;color:var(--muted);line-height:1.5}
.news-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;margin-top:20px}.news{background:var(--panel);border:1px solid var(--line);border-radius:16px;overflow:hidden}.news img{width:100%;height:150px;object-fit:cover}.news-body{padding:15px}.news small{color:var(--cyan);font-size:9px}.news h3{font:700 14px Poppins,sans-serif;margin:7px 0}.news p{font-size:11px;color:var(--muted);line-height:1.6}
.profile-card{background:linear-gradient(145deg,#171e34,#0f1424);border:1px solid var(--line);border-radius:20px;padding:25px;margin-top:20px;text-align:center}
.profile-icon{font-size:45px}.profile-card h2{font-size:21px;margin:8px}.profile-card p{font-size:12px;color:var(--muted);margin-bottom:18px}
.option-list{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:20px}.option{border:1px solid var(--line);background:var(--panel);color:white;border-radius:12px;padding:13px;text-align:left}.option b{display:block;font-size:12px}.option span{font-size:10px;color:var(--muted)}
.toggle{float:right;width:39px;height:22px;border-radius:20px;border:0;background:#36405b;position:relative}.toggle:after{content:"";width:16px;height:16px;border-radius:50%;background:white;position:absolute;left:3px;top:3px;transition:.2s}.toggle.on{background:var(--cyan)}.toggle.on:after{left:20px}
.random-box{margin-top:25px;padding:25px;border:1px solid #60369a;border-radius:18px;text-align:center;background:radial-gradient(ellipse at top,#5b21b633,transparent 70%),var(--panel)}.random-box h2{font-size:19px;margin-bottom:10px}.random-box p{font-size:12px;color:var(--muted);margin-bottom:17px}.random-result{margin-top:15px;color:var(--cyan);font:700 16px Orbitron;min-height:24px}
.modal{display:none;position:fixed;inset:0;background:#000d;z-index:80;align-items:center;justify-content:center;padding:18px}.modal.show{display:flex}.modal-box{width:100%;max-width:600px;max-height:90vh;overflow:auto;background:var(--panel);border:1px solid var(--cyan);border-radius:20px;padding:24px;position:relative;box-shadow:0 20px 80px #000}
.modal-img{width:100%;height:210px;object-fit:cover;border-radius:13px;margin-bottom:15px}.modal-box h2{font-size:22px;margin-bottom:8px}.modal-box p{font-size:12px;color:#c4ccdd;line-height:1.8}.detail-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:15px 0}.detail-item{background:#ffffff07;border:1px solid #ffffff0e;border-radius:10px;padding:10px}.detail-item b{display:block;color:var(--cyan);font-size:9px}.detail-item span{font-size:10px;color:#dce3f4}.close{position:absolute;right:13px;top:9px;background:#080b16cc;border:0;color:white;font-size:25px;width:36px;height:36px;border-radius:50%;z-index:2}
.bottom-nav{position:fixed;bottom:0;left:0;right:0;z-index:70;background:#101523f4;backdrop-filter:blur(18px);border-top:1px solid var(--line);display:flex;justify-content:center;padding:9px 8px calc(9px + env(safe-area-inset-bottom))}
.nav-inner{width:100%;max-width:720px;display:grid;grid-template-columns:repeat(6,1fr);gap:4px}.nav-btn{border:0;background:none;color:#7f8aa3;padding:7px 2px;border-radius:10px;font-size:10px;display:flex;flex-direction:column;align-items:center;gap:4px}.nav-btn .ico{font-size:19px}.nav-btn.active{color:var(--cyan);background:#00e5ff10}
footer{text-align:center;color:#66718a;font-size:10px;padding:42px 0 15px}
body.light{--bg:#eef2f8;--panel:#fff;--panel2:#f5f7fb;--text:#131827;--muted:#657089;--line:#dce2ee;background:#eef2f8}.light .topbar{background:#eef2f8eF}.light .hero{background:linear-gradient(90deg,#101522 0%,#101522dc 40%,#10152230),linear-gradient(0deg,#10152299,transparent),url('https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=1600&q=85') center/cover}

/* NEXUS AI */
.ai-box{margin-top:22px;background:radial-gradient(circle at 15% 0%,#00e5ff18,transparent 35%),radial-gradient(circle at 90% 100%,#a855f722,transparent 38%),var(--panel);border:1px solid #00e5ff35;border-radius:22px;padding:22px;box-shadow:0 18px 55px #0004}
.ai-head{display:flex;gap:14px;align-items:center;margin-bottom:15px}.ai-icon{width:52px;height:52px;border-radius:15px;display:grid;place-items:center;font-size:27px;background:linear-gradient(135deg,#00e5ff25,#a855f735);border:1px solid #00e5ff45}.ai-head h2{font-size:19px}.ai-head p{font-size:11px;color:var(--muted);margin-top:3px}
.ai-form{display:grid;grid-template-columns:1fr 170px;gap:10px}.ai-input,.ai-select{width:100%;background:#080b1666;color:var(--text);border:1px solid var(--line);border-radius:12px;padding:13px;outline:none}.ai-input:focus,.ai-select:focus{border-color:var(--cyan)}.ai-input{min-height:88px;resize:vertical;grid-column:1/-1}
.ai-options{display:grid;grid-template-columns:1fr 1fr;gap:10px}.ai-generate{grid-column:1/-1}
.ai-status{display:none;margin-top:12px;padding:10px 12px;border-radius:10px;background:#00e5ff0b;border:1px solid #00e5ff25;color:#bfefff;font-size:11px}.ai-status.show{display:block}
.ai-result{display:none;margin-top:18px;border-top:1px solid var(--line);padding-top:18px}.ai-result.show{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:18px}.ai-art{min-height:280px;border-radius:16px;overflow:hidden;border:1px solid #ffffff15;background:#080b16;position:relative}.ai-art img{width:100%;height:100%;min-height:280px;object-fit:cover}.ai-art-label{position:absolute;left:10px;top:10px;background:#080b16dd;border:1px solid #00e5ff55;color:var(--cyan);padding:6px 9px;border-radius:8px;font-size:9px;font-weight:700}.ai-copy h3{font-size:23px;margin-bottom:7px}.ai-copy .ai-desc{font-size:12px;color:#cbd3e3;line-height:1.7;margin-bottom:13px}.ai-tags{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:14px}.ai-tag{font-size:9px;padding:6px 8px;border-radius:7px;background:#ffffff08;border:1px solid #ffffff12;color:#d9e0ef}.ai-facts{display:grid;grid-template-columns:1fr 1fr;gap:8px}.ai-fact{padding:9px;border-radius:9px;background:#ffffff06;border:1px solid #ffffff0d}.ai-fact b{display:block;color:var(--cyan);font-size:8px}.ai-fact span{font-size:10px;color:#dce3f4}.ai-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}.ai-note{font-size:9px;color:var(--muted);margin-top:12px;line-height:1.5}.ai-history{margin-top:18px}.ai-history h3{font-size:14px;margin-bottom:10px}.ai-history-list{display:flex;gap:8px;overflow-x:auto}.ai-history-item{min-width:150px;border:1px solid var(--line);background:#ffffff05;border-radius:10px;padding:9px;color:#dfe6f5;font-size:10px;cursor:pointer}.ai-history-item:hover{border-color:#00e5ff66}.ai-history-item span{display:block;color:var(--muted);font-size:8px;margin-top:4px}
@media(max-width:650px){.ai-form,.ai-result.show{grid-template-columns:1fr}.ai-options{grid-template-columns:1fr}.ai-art,.ai-art img{min-height:220px}.ai-actions button{flex:1}}

@keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
@media(max-width:900px){.grid{grid-template-columns:repeat(3,minmax(0,1fr))}.cover{height:140px}.news-grid{grid-template-columns:1fr 1fr}}
@media(max-width:650px){.app{padding:0 14px}.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}.cover{height:125px}.hero{min-height:315px;padding:22px}.quick-stats{grid-template-columns:repeat(2,1fr)}.info-strip,.option-list{grid-template-columns:1fr}.news-grid{grid-template-columns:1fr}.search-row{flex-direction:column}.sort{height:45px}.detail-grid{grid-template-columns:1fr 1fr}}
@media(max-width:370px){.grid{grid-template-columns:1fr}.cover{height:180px}}
</style>
</head>
<body>
<div class="app">
<header class="topbar">
  <div class="logo">NEXUS<b>GAMING</b></div>
  <div class="top-actions">
    <button class="icon-btn" onclick="navigate('favorites')" title="Favoritos">♡</button>
    <div class="avatar">🎮</div>
  </div>
</header>

<main>
<section class="page active" id="home">
  <div class="welcome"><div class="eyebrow">TU UNIVERSO GAMER</div><h1>¡Hola, jugador! 👾</h1><p>Descubre juegos, noticias y nuevas aventuras en un solo lugar.</p></div>
  <div class="hero"><div class="hero-content">
    <span class="pill">⚡ EXPERIENCIA GAMER</span>
    <h2>SUBE DE<br><span>NIVEL</span></h2>
    <p>Explora videojuegos, revisa sus características, guarda tus favoritos y encuentra una nueva aventura para jugar.</p>
    <div class="actions"><button class="primary" onclick="navigate('explore')">Explorar juegos →</button><button class="secondary" onclick="randomGame()">🎲 Juego aleatorio</button></div>
  </div></div>

  <div class="quick-stats">
    <div class="stat"><strong id="totalGames">12</strong><span>Videojuegos</span></div>
    <div class="stat"><strong>06</strong><span>Categorías</span></div>
    <div class="stat"><strong id="homeFav">0</strong><span>Favoritos ❤️</span></div>
    <div class="stat"><strong>24/7</strong><span>Exploración</span></div>
  </div>

  <div class="section-head"><h2>🔥 Recomendados</h2><button class="text-btn" onclick="navigate('explore')">Ver todos →</button></div>
  <div class="grid" id="homeGrid"></div>

  <div class="info-strip">
    <div class="info-box"><b>🎮 Para todos</b><span>Encuentra acción, aventura, carreras, RPG, deportes y supervivencia.</span></div>
    <div class="info-box"><b>❤️ Tu colección</b><span>Guarda tus juegos favoritos y consúltalos cuando quieras.</span></div>
    <div class="info-box"><b>🔎 Búsqueda rápida</b><span>Filtra por género o busca directamente por nombre.</span></div>
  </div>

  <div class="random-box"><h2>🎲 ¿Qué jugamos hoy?</h2><p>Deja que NEXUS elija una aventura al azar.</p><button class="primary" onclick="randomGame()">Descubrir juego</button><div class="random-result" id="homeRandom"></div></div>
</section>

<section class="page" id="ai">
  <div class="welcome"><div class="eyebrow">NUEVA FUNCIÓN</div><h1>NEXUS AI 🤖</h1><p>Crea ideas de videojuegos, información y una portada generada automáticamente.</p></div>
  <div class="ai-box">
    <div class="ai-head"><div class="ai-icon">🤖</div><div><h2>Generador de videojuegos</h2><p>Escribe una idea y NEXUS AI preparará una ficha completa.</p></div></div>
    <div class="ai-form">
      <textarea class="ai-input" id="aiPrompt" placeholder="Ejemplo: Un juego de carreras futuristas en una ciudad de neón, con motos y modo multijugador..."></textarea>
      <div class="ai-options"><select class="ai-select" id="aiGenre"><option value="auto">🎮 Género automático</option><option>Acción</option><option>Aventura</option><option>Carreras</option><option>RPG</option><option>Supervivencia</option><option>Deportes</option></select><select class="ai-select" id="aiPlatform"><option value="auto">💻 Plataforma automática</option><option>PC</option><option>PlayStation</option><option>Xbox</option><option>Nintendo Switch</option><option>Móvil</option></select></div>
      <button class="primary ai-generate" onclick="generateAI()">✨ GENERAR CON NEXUS AI</button>
    </div>
    <div class="ai-status" id="aiStatus"></div>
    <div class="ai-result" id="aiResult">
      <div class="ai-art"><span class="ai-art-label">🖼️ PORTADA IA</span><img id="aiImage" alt="Portada generada para el juego"></div>
      <div class="ai-copy"><h3 id="aiTitle"></h3><p class="ai-desc" id="aiDesc"></p><div class="ai-tags" id="aiTags"></div><div class="ai-facts" id="aiFacts"></div><div class="ai-actions"><button class="primary" onclick="saveAIGame()">＋ Agregar al catálogo</button><button class="secondary" onclick="downloadAIImage()">🖼️ Abrir portada</button><button class="secondary" onclick="generateAI()">🔄 Generar otra</button></div><p class="ai-note">La portada se genera mediante un servicio externo de imágenes. Para usar un modelo de IA de texto propio, configura tu endpoint en <b>NEXUS_AI_ENDPOINT</b> dentro del código.</p></div>
    </div>
    <div class="ai-history" id="aiHistoryWrap" style="display:none"><h3>🧠 Creaciones recientes</h3><div class="ai-history-list" id="aiHistory"></div></div>
  </div>
</section>

<section class="page" id="explore">
  <h1 class="page-title">Explorar 🎮</h1><p class="sub">Busca por nombre, género, plataforma o tipo de juego.</p>
  <div class="search-row"><input class="search" id="searchInput" placeholder="🔍 Buscar videojuegos..." oninput="renderExplore()"><select class="sort" id="sortSelect" onchange="renderExplore()"><option value="default">Ordenar</option><option value="rating">⭐ Valoración</option><option value="name">🔤 Nombre</option><option value="year">📅 Año</option></select></div>
  <div class="filters" id="filters">
    <button class="filter active" onclick="setFilter('Todos',this)">Todos</button><button class="filter" onclick="setFilter('Acción',this)">Acción</button><button class="filter" onclick="setFilter('Aventura',this)">Aventura</button><button class="filter" onclick="setFilter('Carreras',this)">Carreras</button><button class="filter" onclick="setFilter('RPG',this)">RPG</button><button class="filter" onclick="setFilter('Supervivencia',this)">Supervivencia</button><button class="filter" onclick="setFilter('Deportes',this)">Deportes</button>
  </div>
  <div class="grid" id="exploreGrid"><div class="empty" id="exploreEmpty">No se encontraron juegos. Intenta otra búsqueda.</div></div>
</section>

<section class="page" id="favorites">
  <h1 class="page-title">Mis favoritos ❤️</h1><p class="sub">Tu colección personal, guardada en este dispositivo.</p>
  <div class="grid" id="favoritesGrid"><div class="empty" id="favEmpty">Aún no tienes favoritos. Toca ♡ en un juego para guardarlo.</div></div>
</section>

<section class="page" id="news">
  <h1 class="page-title">Noticias y novedades 📰</h1><p class="sub">Información general del mundo gamer para complementar tu página.</p>
  <div class="news-grid">
    <article class="news"><img src="https://images.unsplash.com/photo-1511512578047-dfb367046420?auto=format&fit=crop&w=900&q=80"><div class="news-body"><small>GAMING</small><h3>La evolución de los videojuegos</h3><p>Los videojuegos han pasado de experiencias sencillas a mundos enormes con historias, comunidades y diferentes formas de jugar.</p></div></article>
    <article class="news"><img src="https://images.unsplash.com/photo-1603481546238-487240415921?auto=format&fit=crop&w=900&q=80"><div class="news-body"><small>TECNOLOGÍA</small><h3>Gráficos y nuevas experiencias</h3><p>Las nuevas tecnologías permiten escenarios más detallados, iluminación avanzada y experiencias cada vez más inmersivas.</p></div></article>
    <article class="news"><img src="https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=900&q=80"><div class="news-body"><small>HISTORIA</small><h3>De las consolas clásicas a hoy</h3><p>Las consolas han cambiado muchísimo con el tiempo, pero la diversión de jugar sigue siendo el centro de la experiencia.</p></div></article>
  </div>
</section>

<section class="page" id="profile">
  <h1 class="page-title">Perfil ⚙️</h1><p class="sub">Personaliza algunas opciones de NEXUS GAMING.</p>
  <div class="profile-card">
    <div class="profile-icon">👾</div><h2>Jugador NEXUS</h2><p>Explorador de videojuegos · <span id="favCountProfile">0</span> favoritos guardados</p>
    <div class="actions" style="justify-content:center"><button class="primary" onclick="navigate('explore')">Explorar catálogo</button><button class="secondary" onclick="randomGame()">🎲 Sorpréndeme</button></div>
  </div>
  <div class="option-list">
    <button class="option" onclick="toggleTheme()"><button class="toggle" id="themeToggle"></button><b>🌙 Apariencia</b><span>Cambiar entre modo oscuro y claro.</span></button>
    <button class="option" onclick="clearFavorites()"><b>🗑️ Limpiar favoritos</b><span>Eliminar todos los favoritos guardados.</span></button>
    <button class="option" onclick="navigate('news')"><b>📰 Noticias</b><span>Ver información y novedades gamer.</span></button>
    <button class="option" onclick="alert('NEXUS GAMING · Catálogo web interactivo · Versión 2.0')"><b>ℹ️ Acerca del sitio</b><span>Información sobre este proyecto.</span></button>
  </div>
</section>
</main>

<footer>NEXUS GAMING · Proyecto web interactivo 🎮</footer>
</div>

<nav class="bottom-nav"><div class="nav-inner">
  <button class="nav-btn active" data-page="home" onclick="navigate('home')"><span class="ico">⌂</span>Inicio</button>
  <button class="nav-btn" data-page="explore" onclick="navigate('explore')"><span class="ico">🔎</span>Explorar</button>
  <button class="nav-btn" data-page="favorites" onclick="navigate('favorites')"><span class="ico">♡</span>Favoritos</button>
  <button class="nav-btn" data-page="ai" onclick="navigate('ai')"><span class="ico">🤖</span>NEXUS AI</button>
  <button class="nav-btn" data-page="news" onclick="navigate('news')"><span class="ico">📰</span>Noticias</button>
  <button class="nav-btn" data-page="profile" onclick="navigate('profile')"><span class="ico">⚙️</span>Perfil</button>
</div></nav>

<div class="modal" id="modal" onclick="if(event.target===this)closeModal()">
  <div class="modal-box"><button class="close" onclick="closeModal()">×</button><img class="modal-img" id="modalImg"><h2 id="modalTitle"></h2><p id="modalDesc"></p><div class="detail-grid" id="modalDetails"></div><div class="actions"><button class="primary" id="modalFav">♡ Guardar favorito</button><button class="secondary" onclick="closeModal()">Cerrar</button></div></div>
</div>

<script>
const games=[
{id:1,name:"Cyberpunk 2077",genre:"RPG",year:2020,rating:4.7,platform:"PC · PlayStation · Xbox",hours:"40+ h",online:"No",desc:"Una aventura futurista de mundo abierto llena de decisiones, exploración y acción.",img:"https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=1000&q=80"},
{id:2,name:"Minecraft",genre:"Supervivencia",year:2011,rating:4.9,platform:"PC · Consolas · Móvil",hours:"∞",online:"Sí",desc:"Construye, explora y crea tu propio mundo usando imaginación y recursos.",img:"https://images.unsplash.com/photo-1627856013091-fed6e4e30025?auto=format&fit=crop&w=1000&q=80"},
{id:3,name:"Forza Horizon 5",genre:"Carreras",year:2021,rating:4.8,platform:"PC · Xbox",hours:"30+ h",online:"Sí",desc:"Carreras de mundo abierto con cientos de vehículos y paisajes espectaculares.",img:"https://images.unsplash.com/photo-1503736334956-4c8f8e92946d?auto=format&fit=crop&w=1000&q=80"},
{id:4,name:"God of War Ragnarök",genre:"Acción",year:2022,rating:4.9,platform:"PlayStation · PC",hours:"25+ h",online:"No",desc:"Una aventura de acción con combates, exploración y una historia mitológica.",img:"https://images.unsplash.com/photo-1547394765-185e1e68f34e?auto=format&fit=crop&w=1000&q=80"},
{id:5,name:"The Legend of Zelda",genre:"Aventura",year:2023,rating:4.9,platform:"Nintendo Switch",hours:"60+ h",online:"No",desc:"Explora un enorme mundo, resuelve desafíos y descubre secretos.",img:"https://images.unsplash.com/photo-1578303512597-81e6cc155b3e?auto=format&fit=crop&w=1000&q=80"},
{id:6,name:"EA Sports FC",genre:"Deportes",year:2024,rating:4.5,platform:"PC · PlayStation · Xbox",hours:"∞",online:"Sí",desc:"Partidos de fútbol, modos competitivos y diferentes formas de jugar.",img:"https://images.unsplash.com/photo-1579952363873-27f3bade9f55?auto=format&fit=crop&w=1000&q=80"},
{id:7,name:"Grand Theft Auto V",genre:"Acción",year:2013,rating:4.7,platform:"PC · PlayStation · Xbox",hours:"50+ h",online:"Sí",desc:"Mundo abierto con misiones, exploración y una gran variedad de actividades.",img:"https://images.unsplash.com/photo-1511882150382-421056c89033?auto=format&fit=crop&w=1000&q=80"},
{id:8,name:"Rocket League",genre:"Deportes",year:2015,rating:4.6,platform:"PC · Consolas",hours:"∞",online:"Sí",desc:"Fútbol con vehículos, partidas rápidas y mucha precisión.",img:"https://images.unsplash.com/photo-1553778263-73a83bab9b0c?auto=format&fit=crop&w=1000&q=80"},
{id:9,name:"Hogwarts Legacy",genre:"Aventura",year:2023,rating:4.6,platform:"PC · PlayStation · Xbox",hours:"35+ h",online:"No",desc:"Explora un mundo mágico, aprende habilidades y vive tu propia aventura.",img:"https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=1000&q=80"},
{id:10,name:"Apex Legends",genre:"Acción",year:2019,rating:4.5,platform:"PC · Consolas",hours:"∞",online:"Sí",desc:"Combates por equipos con diferentes personajes y habilidades.",img:"https://images.unsplash.com/photo-1542751110-97427bbecf20?auto=format&fit=crop&w=1000&q=80"},
{id:11,name:"Terraria",genre:"Supervivencia",year:2011,rating:4.8,platform:"PC · Consolas · Móvil",hours:"∞",online:"Sí",desc:"Explora, construye y combate en un mundo lleno de posibilidades.",img:"https://images.unsplash.com/photo-1534423861386-85a16f5d13fd?auto=format&fit=crop&w=1000&q=80"},
{id:12,name:"Need for Speed",genre:"Carreras",year:2022,rating:4.4,platform:"PC · PlayStation · Xbox",hours:"20+ h",online:"Sí",desc:"Velocidad, personalización de vehículos y carreras urbanas.",img:"https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?auto=format&fit=crop&w=1000&q=80"}
];

let currentFilter="Todos";
let favorites=JSON.parse(localStorage.getItem("nexusFavorites")||"[]").map(Number);
let currentModalId=null;

function isFav(id){return favorites.includes(id)}
function saveFav(){localStorage.setItem("nexusFavorites",JSON.stringify(favorites));updateCounters()}
function updateCounters(){
  document.getElementById("homeFav").textContent=favorites.length;
  document.getElementById("favCountProfile").textContent=favorites.length;
}
function card(g){
  return `<article class="card">
    <div class="cover"><img loading="lazy" src="${g.img}" alt="${g.name}"><span class="genre">${g.genre}</span><span class="year">${g.year}</span>
      <button class="heart ${isFav(g.id)?"on":""}" onclick="toggleFavorite(${g.id})">${isFav(g.id)?"♥":"♡"}</button>
    </div>
    <div class="card-body"><h3>${g.name}</h3><p>${g.desc}</p>
      <div class="meta"><span class="tag">🎮 ${g.platform.split(" · ")[0]}</span><span class="tag">⏱ ${g.hours}</span></div>
      <div class="card-foot"><span class="rating">★ ${g.rating}</span><button class="details" onclick="openModal(${g.id})">Más información →</button></div>
    </div>
  </article>`;
}
function renderHome(){document.getElementById("homeGrid").innerHTML=games.slice(0,8).map(card).join("")}
function renderExplore(){
  const q=(document.getElementById("searchInput").value||"").toLowerCase().trim();
  let list=games.filter(g=>(currentFilter==="Todos"||g.genre===currentFilter)&&`${g.name} ${g.genre} ${g.platform}`.toLowerCase().includes(q));
  const sort=document.getElementById("sortSelect").value;
  if(sort==="rating")list.sort((a,b)=>b.rating-a.rating);
  if(sort==="name")list.sort((a,b)=>a.name.localeCompare(b.name));
  if(sort==="year")list.sort((a,b)=>b.year-a.year);
  document.getElementById("exploreGrid").innerHTML=list.length?list.map(card).join(""):`<div class="empty" style="display:block">No se encontraron juegos. Intenta otra búsqueda.</div>`;
}
function renderFavorites(){
  const list=games.filter(g=>isFav(g.id));
  document.getElementById("favoritesGrid").innerHTML=list.length?list.map(card).join(""):`<div class="empty" style="display:block">Aún no tienes favoritos. Toca ♡ en un juego para guardarlo.</div>`;
}
function toggleFavorite(id){
  if(isFav(id))favorites=favorites.filter(x=>x!==id);else favorites.push(id);
  saveFav();renderHome();renderExplore();renderFavorites();
  if(currentModalId===id)document.getElementById("modalFav").textContent=isFav(id)?"♥ Guardado":"♡ Guardar favorito";
}
function setFilter(filter,el){
  currentFilter=filter;
  document.querySelectorAll(".filter").forEach(b=>b.classList.remove("active"));
  el.classList.add("active");renderExplore();
}
function navigate(page){
  document.querySelectorAll(".page").forEach(p=>p.classList.remove("active"));
  document.getElementById(page).classList.add("active");
  document.querySelectorAll(".nav-btn").forEach(b=>b.classList.toggle("active",b.dataset.page===page));
  if(page==="explore")renderExplore();if(page==="favorites")renderFavorites();window.scrollTo({top:0,behavior:"smooth"});
}
function randomGame(){
  const g=games[Math.floor(Math.random()*games.length)];
  document.getElementById("homeRandom").textContent="🎮 "+g.name;
  openModal(g.id);
}
function openModal(id){
  const g=games.find(x=>x.id===id);if(!g)return;currentModalId=id;
  document.getElementById("modalImg").src=g.img;document.getElementById("modalTitle").textContent=g.name;document.getElementById("modalDesc").textContent=g.desc;
  document.getElementById("modalDetails").innerHTML=`<div class="detail-item"><b>GÉNERO</b><span>${g.genre}</span></div><div class="detail-item"><b>AÑO</b><span>${g.year}</span></div><div class="detail-item"><b>VALORACIÓN</b><span>★ ${g.rating}</span></div><div class="detail-item"><b>PLATAFORMAS</b><span>${g.platform}</span></div><div class="detail-item"><b>DURACIÓN</b><span>${g.hours}</span></div><div class="detail-item"><b>ONLINE</b><span>${g.online}</span></div>`;
  document.getElementById("modalFav").textContent=isFav(id)?"♥ Guardado":"♡ Guardar favorito";document.getElementById("modalFav").onclick=()=>toggleFavorite(id);document.getElementById("modal").classList.add("show");
}
function closeModal(){document.getElementById("modal").classList.remove("show")}
function clearFavorites(){favorites=[];saveFav();renderHome();renderExplore();renderFavorites();alert("Favoritos eliminados.")}
function toggleTheme(){document.body.classList.toggle("light");document.getElementById("themeToggle").classList.toggle("on",document.body.classList.contains("light"));localStorage.setItem("nexusTheme",document.body.classList.contains("light")?"light":"dark")}

/* ---------------- NEXUS AI ---------------- */
// Déjalo vacío para usar el modo local de demostración. Si tienes un backend propio,
// coloca aquí su URL, por ejemplo: https://tu-servidor.com/api/generate-game
const NEXUS_AI_ENDPOINT = "";
let aiCurrent = null;
let aiHistory = JSON.parse(localStorage.getItem("nexusAIHistory") || "[]");

const aiNameParts = ["Neon","Shadow","Cyber","Pixel","Nova","Hyper","Dark","Quantum","Turbo","Galaxy","Apex","Nexus"];
const aiNameEnds = ["Rift","Legends","Rush","Frontier","Arena","Chronicles","Protocol","Storm","Odyssey","X","Zero","Evolution"];
const aiImages = {
  "Acción":"https://image.pollinations.ai/prompt/futuristic%20action%20video%20game%20cover%20neon%20city%20cinematic%20digital%20art?width=1024&height=1024&nologo=true",
  "Aventura":"https://image.pollinations.ai/prompt/epic%20adventure%20video%20game%20cover%20fantasy%20world%20cinematic%20digital%20art?width=1024&height=1024&nologo=true",
  "Carreras":"https://image.pollinations.ai/prompt/futuristic%20racing%20video%20game%20cover%20neon%20cars%20city%20cinematic%20digital%20art?width=1024&height=1024&nologo=true",
  "RPG":"https://image.pollinations.ai/prompt/fantasy%20RPG%20video%20game%20cover%20hero%20cinematic%20digital%20art?width=1024&height=1024&nologo=true",
  "Supervivencia":"https://image.pollinations.ai/prompt/survival%20video%20game%20cover%20mysterious%20island%20cinematic%20digital%20art?width=1024&height=1024&nologo=true",
  "Deportes":"https://image.pollinations.ai/prompt/futuristic%20sports%20video%20game%20cover%20stadium%20cinematic%20digital%20art?width=1024&height=1024&nologo=true"
};
function pick(a){return a[Math.floor(Math.random()*a.length)]}
function inferGenre(text){
  const t=text.toLowerCase();
  if(/carrer|auto|moto|velocidad|racing|conduc/.test(t))return "Carreras";
  if(/futbol|fútbol|baloncesto|basket|deporte|tenis/.test(t))return "Deportes";
  if(/zombi|zombie|superviv|recursos|isla|apocal/.test(t))return "Supervivencia";
  if(/magia|dragón|fantasía|fantasia|caballero|hechizo|rol/.test(t))return "RPG";
  if(/explorar|aventura|misterio|tesoro|viaje/.test(t))return "Aventura";
  return "Acción";
}
function inferPlatform(text){
  const t=text.toLowerCase();
  if(t.includes("móvil")||t.includes("movil")||t.includes("android"))return "Móvil";
  if(t.includes("switch")||t.includes("nintendo"))return "Nintendo Switch";
  if(t.includes("xbox"))return "Xbox";
  if(t.includes("playstation")||t.includes("ps5")||t.includes("ps4"))return "PlayStation";
  return "PC · PlayStation · Xbox";
}
function localAIGame(prompt,genreChoice,platformChoice){
  const genre=genreChoice==="auto"?inferGenre(prompt):genreChoice;
  const platform=platformChoice==="auto"?inferPlatform(prompt):platformChoice;
  const name=`${pick(aiNameParts)} ${pick(aiNameEnds)}`;
  const seed=encodeURIComponent(`${name} ${genre} video game cover ${prompt}`);
  const img=`https://image.pollinations.ai/prompt/${seed}?width=1024&height=1024&nologo=true`;
  const descriptions={
    Acción:`Una experiencia de ${genre.toLowerCase()} centrada en combates dinámicos, exploración y decisiones rápidas. La idea toma como base: ${prompt}.`,
    Aventura:`Una aventura de exploración en la que el jugador descubre lugares, secretos y desafíos. La propuesta parte de: ${prompt}.`,
    Carreras:`Un juego de velocidad con circuitos, vehículos personalizables y desafíos competitivos. La idea principal es: ${prompt}.`,
    RPG:`Un RPG con progresión de personaje, habilidades, exploración y decisiones. El concepto parte de: ${prompt}.`,
    Supervivencia:`Una experiencia de supervivencia donde administrar recursos, explorar y superar peligros es fundamental. El concepto parte de: ${prompt}.`,
    Deportes:`Una experiencia deportiva con partidas, progresión y diferentes retos. El concepto parte de: ${prompt}.`
  };
  return {name,genre,year:2026,rating:(4+Math.random()).toFixed(1),platform,hours:genre==="Carreras"||genre==="Deportes"?"∞":"25+ h",online:"Sí",desc:descriptions[genre],img,prompt};
}
async function generateAI(){
  const prompt=document.getElementById("aiPrompt").value.trim();
  if(!prompt){alert("Escribe primero una idea para tu videojuego.");return}
  const genre=document.getElementById("aiGenre").value, platform=document.getElementById("aiPlatform").value;
  const status=document.getElementById("aiStatus");status.classList.add("show");status.textContent="⚡ NEXUS AI está creando tu videojuego...";
  try{
    let data;
    if(NEXUS_AI_ENDPOINT){
      const res=await fetch(NEXUS_AI_ENDPOINT,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({prompt,genre,platform})});
      if(!res.ok)throw new Error("Endpoint no disponible");
      data=await res.json();
    }else{
      await new Promise(r=>setTimeout(r,650));
      data=localAIGame(prompt,genre,platform);
    }
    aiCurrent=data;showAIResult(data);saveAIHistory(data);status.textContent=NEXUS_AI_ENDPOINT?"✅ Juego generado por tu servicio de IA.":"✅ Creación lista. La información usa el generador local y la portada se genera con IA.";
  }catch(e){
    aiCurrent=localAIGame(prompt,genre,platform);showAIResult(aiCurrent);status.textContent="⚠️ No se pudo conectar con el servicio de IA. Se usó el modo local de respaldo.";
  }
}
function showAIResult(g){
  document.getElementById("aiResult").classList.add("show");document.getElementById("aiTitle").textContent=g.name;document.getElementById("aiDesc").textContent=g.desc;
  document.getElementById("aiImage").src=g.img;document.getElementById("aiTags").innerHTML=`<span class="ai-tag">🎮 ${g.genre}</span><span class="ai-tag">💻 ${g.platform}</span><span class="ai-tag">⭐ ${g.rating}</span>`;
  document.getElementById("aiFacts").innerHTML=`<div class="ai-fact"><b>AÑO</b><span>${g.year}</span></div><div class="ai-fact"><b>DURACIÓN</b><span>${g.hours}</span></div><div class="ai-fact"><b>ONLINE</b><span>${g.online}</span></div><div class="ai-fact"><b>TIPO</b><span>${g.genre}</span></div>`;
}
function saveAIHistory(g){aiHistory=[g,...aiHistory.filter(x=>x.name!==g.name)].slice(0,6);localStorage.setItem("nexusAIHistory",JSON.stringify(aiHistory));renderAIHistory()}
function renderAIHistory(){const wrap=document.getElementById("aiHistoryWrap"),list=document.getElementById("aiHistory");if(!list)return;wrap.style.display=aiHistory.length?"block":"none";list.innerHTML=aiHistory.map((g,i)=>`<button class="ai-history-item" onclick="loadAIHistory(${i})">🎮 ${g.name}<span>${g.genre} · ${g.year}</span></button>`).join("")}
function loadAIHistory(i){aiCurrent=aiHistory[i];showAIResult(aiCurrent);document.getElementById("aiStatus").classList.add("show");document.getElementById("aiStatus").textContent="🧠 Creación recuperada de tu historial."}
function saveAIGame(){
  if(!aiCurrent)return;const id=Date.now();games.push({id,name:aiCurrent.name,genre:aiCurrent.genre,year:aiCurrent.year,rating:Number(aiCurrent.rating),platform:aiCurrent.platform,hours:aiCurrent.hours,online:aiCurrent.online,desc:aiCurrent.desc,img:aiCurrent.img});
  renderHome();renderExplore();alert(`🎮 ${aiCurrent.name} fue agregado al catálogo.`);
}
function downloadAIImage(){if(aiCurrent?.img)window.open(aiCurrent.img,"_blank")}

function init(){
  renderHome();renderExplore();renderFavorites();updateCounters();renderAIHistory();
  if(localStorage.getItem("nexusTheme")==="light"){document.body.classList.add("light");document.getElementById("themeToggle").classList.add("on")}
}
init();
</script>
</body>
</html>
